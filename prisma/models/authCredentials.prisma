model Credential {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  passwordHash          String
  mustChangePassword    Boolean  @default(false)
  passwordChangedAt     DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

enum AuthChallengePurpose {
  EMAIL_VERIFICATION
  LOGIN_MFA
  PASSWORD_RESET
  APPLICATION_EMAIL_VERIFICATION
  APPLICATION_STATUS_LOOKUP
}

model EmailOtpChallenge {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String?              @db.Uuid
  applicationId    String?              @db.Uuid
  emailNormalized String
  purpose          AuthChallengePurpose
  digest           String
  attempts         Int                  @default(0)
  maxAttempts      Int                  @default(5)
  expiresAt        DateTime
  resendAt         DateTime
  consumedAt       DateTime?
  supersededAt     DateTime?
  createdAt        DateTime             @default(now())
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      ProcurerApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([emailNormalized, purpose, createdAt])
  @@index([userId, purpose, expiresAt])
  @@map("email_otp_challenges")
}

model LoginChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique
  userId        String   @db.Uuid
  purpose       LoginChallengePurpose @default(LOGIN_MFA)
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("login_challenges")
}

enum LoginChallengePurpose {
  LOGIN_MFA
  MFA_ENROLLMENT
}

model RefreshToken {
  id                  String      @id @default(uuid()) @db.Uuid
  sessionId           String      @db.Uuid
  familyId            String      @db.Uuid
  tokenHash           String      @unique
  replacedByTokenHash String?
  consumedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime    @default(now())
  session             AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}
