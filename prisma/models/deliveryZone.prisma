model ProcurerServiceZone {
  id               String          @id @default(uuid()) @db.Uuid
  profileId        String          @db.Uuid
  profile          ProcurerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  country          String          @db.VarChar(2)
  region           String          @db.VarChar(100)
  city             String          @db.VarChar(100)
  area             String          @db.VarChar(100)
  deliveryFeeMinor BigInt
  currency         String          @db.VarChar(3)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([profileId, country, region, city, area])
  @@index([country, region, city, area, active])
  @@map("procurer_service_zones")
}
