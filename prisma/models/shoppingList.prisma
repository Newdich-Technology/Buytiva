enum ShoppingListStatus {
  DRAFT
  SUBMITTED
}

model ShoppingList {
  id          String             @id @default(uuid()) @db.Uuid
  customerId  String             @db.Uuid
  customer    User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title       String             @db.VarChar(120)
  currency    String             @db.VarChar(3)
  notes       String?            @db.VarChar(2000)
  status      ShoppingListStatus @default(DRAFT)
  revision    Int                @default(0)
  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       ShoppingListItem[]
  shoppingRequests ShoppingRequest[]

  @@index([customerId, createdAt, id])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id                     String       @id @default(uuid()) @db.Uuid
  listId                 String       @db.Uuid
  list                   ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name                   String       @db.VarChar(160)
  quantityMilli          Int
  expectedUnitPriceMinor BigInt
  notes                  String?      @db.VarChar(1000)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([listId, createdAt, id])
  @@map("shopping_list_items")
}
