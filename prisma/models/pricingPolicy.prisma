model ProcurerPricingPolicy {
  id                    String          @id @default(uuid()) @db.Uuid
  quotations            Quotation[]
  profileId             String          @db.Uuid
  profile               ProcurerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  version               Int
  currency              String          @db.VarChar(3)
  fixedFeeMinor         BigInt
  thresholdMinor        BigInt
  percentageBasisPoints Int
  createdAt             DateTime        @default(now())

  @@unique([profileId, version])
  @@index([profileId, createdAt])
  @@map("procurer_pricing_policies")
}
