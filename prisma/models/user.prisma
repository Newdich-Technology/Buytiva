enum UserRole {
  CUSTOMER
  PROCURER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MfaFactorType {
  TOTP
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String
  emailNormalized          String                    @unique
  passwordHash             String?
  emailVerifiedAt          DateTime?
  status                   UserStatus                @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  roleAssignments          RoleAssignment[]          @relation("AssignedRoles")
  grantedRoleAssignments   RoleAssignment[]          @relation("RoleGrantor")
  sessions                 AuthSession[]
  emailVerifications       EmailVerificationToken[]
  mfaFactors               MfaFactor[]
  procurerApplications     ProcurerApplication[]
  reviewedApplications     ProcurerApplicationStatusHistory[] @relation("ApplicationReviewer")
  auditEvents              AuditLog[]                @relation("AuditActor")

  @@index([status, createdAt])
  @@map("users")
}

model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  role        UserRole
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation("AssignedRoles", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User?     @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@map("role_assignments")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model MfaFactor {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  type            MfaFactorType
  secretCiphertext Bytes
  enabledAt       DateTime?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabledAt])
  @@map("mfa_factors")
}
