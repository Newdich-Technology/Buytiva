enum UserRole {
  CUSTOMER
  PROCURER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MfaFactorType {
  TOTP
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String
  emailNormalized          String                    @unique
  passwordHash             String?
  displayName              String?
  emailVerifiedAt          DateTime?
  status                   UserStatus                @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  roleAssignments          RoleAssignment[]          @relation("AssignedRoles")
  grantedRoleAssignments   RoleAssignment[]          @relation("RoleGrantor")
  sessions                 AuthSession[]
  emailVerifications       EmailVerificationToken[]
  mfaFactors               MfaFactor[]
  procurerApplications     ProcurerApplication[]
  reviewedApplications     ProcurerApplicationStatusHistory[] @relation("ApplicationReviewer")
  auditEvents              AuditLog[]                @relation("AuditActor")
  credential               Credential?
  emailOtpChallenges       EmailOtpChallenge[]
  loginChallenges          LoginChallenge[]
  permissionGrants         UserPermissionGrant[]
  grantedPermissionGrants UserPermissionGrant[]       @relation("PermissionGrantor")
  createdInvitations       AccountInvitation[]        @relation("InvitationIssuer")
  acceptedInvitations      AccountInvitation[]        @relation("InvitationAcceptor")
  procurerProfile          ProcurerProfile?
  passwordResetTokens     PasswordResetToken[]
  reviewReports           ReviewReport[]
  orderHistory            ProcurementOrderHistory[]
  shoppingRequests        ShoppingRequest[]          @relation("CustomerShoppingRequests")
  shoppingLists           ShoppingList[]
  customerAddresses       CustomerAddress[]
  staffProfile            StaffProfile?

  @@index([status, createdAt])
  @@map("users")
}

model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  role        UserRole
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  user        User      @relation("AssignedRoles", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User?     @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@map("role_assignments")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  familyId   String    @default(uuid()) @db.Uuid
  deviceLabel String?
  assurance  String    @default("PASSWORD")
  mfaVerifiedAt DateTime?
  revokedReason String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model MfaFactor {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  type            MfaFactorType
  secretCiphertext Bytes
  enabledAt       DateTime?
  disabledAt      DateTime?
  lastAcceptedTimeStep BigInt?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabledAt])
  @@map("mfa_factors")
}
