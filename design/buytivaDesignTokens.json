  "typography": {
    "displayFamily": "Fraunces",
    "bodyFamily": "Manrope",
    "heroDesktop": {
      "min": 76,
      "max": 156,
      "weight": 700,
      "lineHeight": 0.89
    },
    "heroMobile": {
      "min": 48,
      "max": 78,
      "weight": 700,
      "lineHeight": 0.96
    },
    "pageTitleDesktop": {
      "fontSize": 36,
      "weight": 700,
      "lineHeight": 1.12
    },
    "pageTitleMobile": {
      "fontSize": 28,
      "weight": 700,
      "lineHeight": 1.14
    },
    "sectionTitle": {
      "fontSize": 28,
      "weight": 700
    },
    "cardTitle": {
      "fontSize": 20,
      "weight": 650
    },
    "bodyLarge": {
      "fontSize": 18,
      "weight": 400,
      "lineHeight": 1.55
    },
    "body": {
      "fontSize": 16,
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "fontSize": 14,
      "weight": 450,
      "lineHeight": 1.45
    },
    "caption": {
      "fontSize": 12,
      "weight": 450,
      "lineHeight": 1.4
    },
    "amount": {
      "fontSize": 32,
      "weight": 700,
      "fontVariant": "tabular-nums"
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "2xl": 32,
    "pill": 9999
  },
  "components": {
    "button": {
      "height": 52,
      "radius": "md",
      "targetMin": 48
    },
    "input": {
      "height": 56,
      "radius": "md"
    },
    "card": {
      "radius": "lg",
      "padding": 20
    },
    "modal": {
      "radius": "xl"
    },
    "bottomSheet": {
      "radius": "xl"
    },
    "iconButton": {
      "targetMin": 48,
      "visualSize": 24
    },
    "nav": {
      "desktopHeight": 72,
      "mobileHeight": 64
    },
    "sidebar": {
      "desktopWidth": 248
    },
    "focusOutlinePx": 3
  },
  "motion": {
    "instantMs": 100,
    "tapMs": 160,
    "fastMs": 220,
    "normalMs": 300,
    "successMs": 420,
    "illustrationMs": 750,
    "entranceStaggerMs": 90,
    "easingStandard": "cubic-bezier(0.2,0.8,0.2,1)",
    "easingExit": "cubic-bezier(0.4,0,1,1)",
    "reducedMotion": "static state / opacity-only where safe, no loop or parallax"
  },
  "breakpoints": {
    "compactMax": 599,
    "mediumMin": 600,
    "mediumMax": 1023,
    "desktopMin": 1024,
    "wideMin": 1440
  },
  "content": {
    "publicMaxWidth": 1280,
    "dashboardMaxWidth": 1560,
    "mobileGutter": 20,
    "desktopGutter": 32,
    "heroViewportMaxWidth": 1600
  },
  "designRules": [
    "Single canonical source translated to Flutter ThemeData/ThemeExtensions and CSS variables",
    "Primitives not referenced directly in business screens; use semantic tokens",
    "Accent colors are illustrative and require contrast checks before used as text",
    "Never invert logo/illustrations for dark mode",
    "Typography and spacing adapt to OS text scaling",
    "Icons and images have reserved dimensions to prevent layout shift",
    "No hardcoded backend commission or delivery prices in tokens"
  ]
}
