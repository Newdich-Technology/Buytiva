{
  "name": "buytiva-procurement-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:file-length": "tsx scripts/checkFileLength.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:sync": "prisma db push"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "author": "Oluwayemi Oyinlola"
}
