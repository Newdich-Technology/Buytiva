NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Dedicated development database only; never run db:sync against production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buytiva?schema=public
# Generate independent high-entropy secrets. Do not commit real values.
AUTH_TOKEN_SECRET=
AUTH_OTP_PEPPER=
# Base64-encoded, independently generated 32-byte key.
AUTH_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:5173
# TLS is required for SMTP; configure secure=true for implicit TLS or false for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required only for issuing quotations. Explicitly approve and version the commission policy.
PLATFORM_COMMISSION_POLICY_VERSION=
PLATFORM_COMMISSION_BASIS_POINTS=
# Only for destructive integration tests on an isolated disposable PostgreSQL database.
# AUTH_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buytiva_test
